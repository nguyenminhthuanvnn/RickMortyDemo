default_platform(:android)

platform :android do

  desc "Run unit tests"
  lane :test do
    gradle(task: "testStagingReleaseUnitTest")
  end

  desc "Run Android Lint"
  lane :lint do
    gradle(task: "lintStagingRelease")
  end

  desc "Build a debug APK (used for local/interview demo runs)"
  lane :build_debug do
    gradle(task: "assembleDebug")
  end

  desc "Build a release APK"
  lane :build_release do
    gradle(
      task: "assemble",
      build_type: "Release"
    )
  end

  desc "Build a release AAB (App Bundle) for Play Store upload"
  lane :build_bundle do
    gradle(task: "bundleRelease")
  end

  desc "Full CI pipeline: lint -> unit tests -> assemble debug"
  lane :ci do
    lint
    test
    build_release
  end

  desc "Distribute Staging build to Firebase App Distribution"
  lane :distribute_staging do |options|
    # 1. Build the Staging Release APK
    version_code = options[:version_code] || ENV["VERSION_CODE"]
    version_name = options[:version_name] || ENV["VERSION_NAME"]

    gradle(
      task: "assembleStagingRelease",
      properties: {
        "versionCode" => version_code,
        "versionName" => version_name
      }.delete_if { |k, v| v.nil? }
    )

    # 2. Upload to Firebase
    firebase_app_distribution(
      app: ENV["FIREBASE_APP_ID"] || "1:943783289079:android:770a102a2687776fd5f3f2",
      groups: ENV["FIREBASE_DISTRIBUTION_GROUPS"] || "testers",
      service_credentials_file: ENV["FIREBASE_CREDENTIALS_PATH"],
      release_notes: "Build from CI: " + (last_git_commit[:message] rescue "No commit message"),
      apk_path: "app/build/outputs/apk/staging/release/app-staging-release.apk"
    )
  end

  desc "Deploy a release build to the Play Store internal testing track"
  lane :deploy_internal do
    build_bundle
    upload_to_play_store(
      track: "internal",
      aab: "app/build/outputs/bundle/release/app-release.aab",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  error do |lane, exception, options|
    UI.error("Fastlane lane #{lane} failed: #{exception.message}")
  end
end
